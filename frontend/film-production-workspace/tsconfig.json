/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@film-production/core": [
        "./dist/core"
      ],
      "@film-production/auth": [
        "./projects/auth/src/public-api.ts"
      ],
      "@film-production/shared": [
        "./projects/shared/src/public-api.ts"
      ],
      "@film-production/ui": [
        "./projects/ui/src/public-api.ts"
      ],
      "@film-production/models": [
        "./projects/models/src/public-api.ts"
      ],
      "@film-production/utils": [
        "./projects/utils/src/public-api.ts"
      ]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/portal/tsconfig.app.json"
    },
    {
      "path": "./projects/portal/tsconfig.spec.json"
    },
    {
      "path": "./projects/admin-portal/tsconfig.app.json"
    },
    {
      "path": "./projects/admin-portal/tsconfig.spec.json"
    },
    {
      "path": "./projects/auth/tsconfig.lib.json"
    },
    {
      "path": "./projects/auth/tsconfig.spec.json"
    },
    {
      "path": "./projects/core/tsconfig.lib.json"
    },
    {
      "path": "./projects/core/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/tsconfig.spec.json"
    },
    {
      "path": "./projects/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/models/tsconfig.lib.json"
    },
    {
      "path": "./projects/models/tsconfig.spec.json"
    },
    {
      "path": "./projects/utils/tsconfig.lib.json"
    },
    {
